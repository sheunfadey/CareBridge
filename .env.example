# =============================================================================
# CareBridge — environment configuration example
# Copy to .env.local for local development. NEVER commit real secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Supabase (Phase 2+) -----------------------------------------------------
# Project URL and anon key are safe for the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Phase 6+) -----------------------------------------------------
# Server-only secret. Used for payment verification and transfers.
PAYSTACK_SECRET_KEY=
# Public key is safe for the browser checkout widget.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Webhook signing secret. Verify every webhook signature server-side.
PAYSTACK_WEBHOOK_SECRET=
# Set to "sandbox" until live transfers are explicitly approved.
PAYSTACK_MODE=sandbox
# Leave false until the payout arrangement is approved. Payouts can be reviewed
# and approved while this is false, but no transfer is sent.
PAYSTACK_TRANSFERS_ENABLED=false

# --- Email provider abstraction (Phase 3+) -----------------------------------
# EMAIL_PROVIDER: "resend" to deliver, or "console" (default) to log only.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@carebridge.ng
EMAIL_FROM_NAME=CareBridge

# --- SMS / messaging provider (optional, later phase) ------------------------
SMS_PROVIDER_API_KEY=

# --- Storage provider configuration (Phase 4+) -------------------------------
# Uses Supabase Storage buckets by default. Set explicit bucket names here.
STORAGE_BUCKET_PRIVATE_DOCUMENTS=
STORAGE_BUCKET_PUBLIC_MEDIA=

# --- Background jobs (Phase 4+) ----------------------------------------------
BACKGROUND_JOB_SECRET=

# --- Error monitoring (optional) ---------------------------------------------
ERROR_MONITORING_DSN=
